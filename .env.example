# OpenAI API key, used by the talk-to-data NL-to-SQL chatbot and LLM-based explanation summaries.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Model to use for NL-to-SQL and explanations (gpt-4o-mini is cheap and fast, upgrade if you have credits)
OPENAI_MODEL=gpt-4o-mini

# Postgres connection string for the talk-to-data database (Neon in production).
# If unset, the app falls back to the local SQLite file at data/processed/credit_risk.db
# (built by `python -m src.data.build_database`), which is what the Docker/local setup uses.
# Example: postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=

# Origin of the deployed frontend (Vercel URL), used for CORS on the FastAPI backend.
# Leave unset ("*") for local development.
FRONTEND_ORIGIN=
