# OpenAI API key — used by the talk-to-data NL-to-SQL chatbot and LLM-based explanation summaries.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Model to use for NL-to-SQL and explanations (gpt-4o-mini is cheap and fast; upgrade if you have credits)
OPENAI_MODEL=gpt-4o-mini

# Path to the SQLite database file used by the talk-to-data module (built from the Home Credit CSVs)
DATABASE_PATH=data/processed/credit_risk.db

# Path to the trained model artifact used by the API/UI for inference
MODEL_PATH=models/model.joblib
