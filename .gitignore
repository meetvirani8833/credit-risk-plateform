# Environment / secrets
.env
*.kaggle/
kaggle.json
access_token

# Data (never commit the full raw dataset)
data/raw/
data/processed/
*.csv
*.zip

# Exception: the small, curated demo dataset IS committed on purpose, it
# powers the public deployment (no dataset mounting available there), see
# README section on the two data modes. A few MB, not "the dataset."
!data/sample/
!data/sample/*.csv
!data/sample/*.db

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Model artifacts: model.joblib IS committed on purpose, the assignment
# requires saved model artifacts in the repo. Only ignore stray/large
# intermediate files that show up during experimentation.
models/*.tmp
models/checkpoint_*

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
